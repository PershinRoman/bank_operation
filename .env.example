# Конфигурация базы данных
DATABASE_HOST=localhost      # Хост для базы данных
DATABASE_USER=username       # Имя пользователя базы данных
DATABASE_PASSWORD=password   # Пароль базы данных
DATABASE_NAME=mydatabase     # Имя базы данных

# API-ключи
API_KEY=your_api_key_here    # Ваш API ключ
GITHUB_TOKEN=your_github_token_here  # Токен для GitHub API

# Другие переменные окружения (если необходимо)
ANOTHER_API_KEY=another_api_key_here  # Другой API ключ (если есть)